# Records the no-tenant walkthrough: vhs docs/demo.tape (run from the repo root)
Output docs/demo.gif
Output docs/demo.mp4

Set Shell "bash"
Set FontSize 15
Set Width 1760
Set Height 900
Set Padding 24
Set Theme "Dracula"
Set TypingSpeed 45ms

Hide
Type "export PS1='$ ' && clear"
Enter
Show

Type "npm run -s demo -- --step"
Sleep 400ms
Enter
Sleep 4s

# one Enter per step, with time to read each result
Enter
Sleep 7s
Enter
Sleep 7s
Enter
Sleep 8s
Enter
Sleep 9s
Enter
Sleep 8s
Enter
Sleep 9s

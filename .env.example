# Copy to .env (ignored by git) and fill in after guide/02-set-up-auth0.md.
# Every npm script except `demo` and `test` reads this file.

# --- Your tenant ---------------------------------------------------------
# Tenant domain, without https://
AUTH0_DOMAIN=your-tenant.us.auth0.com
# The same tenant as an issuer URL. Keep the trailing slash.
AUTH0_ISSUER=https://your-tenant.us.auth0.com/

# --- The two APIs (identifiers must match Auth0 exactly, trailing slash included) ---
# The MCP server's API identifier. Tokens must carry it as their audience.
MCP_RESOURCE=https://reports.demo.test/
# The reports API's identifier. The MCP server exchanges tokens for this audience.
REPORTS_AUDIENCE=https://reports-backend.demo.test/
# Where `npm run start:api` listens (port 3100 by default)
REPORTS_API_URL=http://localhost:3100

# --- Token exchange application (app_type resource_server, guide step 2.6) ---
TOKEN_EXCHANGE_CLIENT_ID=your-exchange-client-id
TOKEN_EXCHANGE_CLIENT_SECRET=your-exchange-client-secret

# --- Login application (guide step 2.5) ------------------------------------
LOGIN_CLIENT_ID=your-login-client-id
# Scopes to request at login. Add read:github for the Token Vault tools.
LOGIN_SCOPE=openid profile email read:reports read:github

# --- Where tokens are saved (the .tokens/ folder is ignored by git) ---------
TOKEN_OUT=.tokens/user-token
TOKEN_FILE=.tokens/user-token
MCP_URL=http://localhost:3000/mcp

# --- Token Vault account linking (guide/04-token-vault.md) -------------------
ME_TOKEN_FILE=.tokens/me-token
